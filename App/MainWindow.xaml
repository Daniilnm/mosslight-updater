<Window x:Class="Mosslight.Update.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Mosslight · Обновление сборки" Width="1160" Height="790" MinWidth="960" MinHeight="700" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}" Foreground="#EEF2ED" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="CaptureRoot" Background="{StaticResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#171C18" BorderBrush="#29312B" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="14,24,14,0"><Border Width="48" Height="48" Background="#6AAE42" CornerRadius="6"><TextBlock Text="ML" FontFamily="Consolas" FontWeight="Bold" FontSize="23" Foreground="#12210F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="UPDATE" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center" Margin="0,9,0,24" Foreground="#A1AD9F"/>
    <Button Style="{StaticResource SecondaryButton}" Padding="0" Height="46" ToolTip="Главная" AutomationProperties.Name="Главная" Click="Home_Click" Margin="0,0,0,10"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Button>
    <Button Style="{StaticResource SecondaryButton}" Padding="0" Height="46" ToolTip="Настройки и восстановление" AutomationProperties.Name="Настройки и восстановление" Click="Settings_Click"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="20"/></Button>
   </StackPanel><TextBlock DockPanel.Dock="Bottom" Text="1.0.0" FontFamily="Consolas" Foreground="#849284" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,22"/><Grid/>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,22,30,20"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="MOSSLIGHT" FontWeight="Bold" FontSize="17"/><Border Background="#2B352A" CornerRadius="3" Margin="12,0,0,0" Padding="8,3"><TextBlock Text="ДЛЯ НАШИХ" FontSize="10" FontWeight="SemiBold" Foreground="#A8CA97"/></Border></StackPanel><TextBlock Text="MINECRAFT 1.21.1  ·  NEOFORGE" FontFamily="Consolas" FontSize="11" Foreground="#94A493" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"/></Grid>
   <Grid Grid.Row="1">
    <Grid x:Name="HomeView"><Grid.RowDefinitions><RowDefinition Height="*" MinHeight="270"/><RowDefinition Height="112"/></Grid.RowDefinitions>
     <Border CornerRadius="9" ClipToBounds="True" BorderBrush="#3B473F" BorderThickness="1"><Grid>
      <Image Source="Assets/hero.png" Stretch="UniformToFill"/>
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.3"><GradientStop Color="#E50B1916" Offset="0"/><GradientStop Color="#90101B17" Offset="0.48"/><GradientStop Color="#100A120E" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#BF07140F" Offset="0"/><GradientStop Color="#000A120E" Offset="0.65"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
      <StackPanel Margin="34,31,24,20" VerticalAlignment="Center"><TextBlock Text="Mosslight" FontFamily="Consolas" FontWeight="Bold" FontSize="52" Foreground="White" Margin="-3,0,0,8"/><TextBlock Text="Твоя сборка.&#10;Всегда актуальна." FontSize="27" FontWeight="SemiBold" LineHeight="34"/><TextBlock Text="Меньше скачиваний. Больше приключений." FontSize="14" Margin="0,17,0,0" Foreground="#C4D1C7"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Border Background="#D91C3021" BorderBrush="#55794D" BorderThickness="1" CornerRadius="4" Padding="11,6"><TextBlock Text="{Binding VersionLabel}" FontFamily="Consolas" FontSize="12" Foreground="#BCED9D"/></Border><TextBlock Text="СВОЯ СБОРКА · СВОЯ КОМПАНИЯ" Margin="13,8,0,0" FontSize="10" Foreground="#B2C5B3"/></StackPanel></StackPanel>
     </Grid></Border>
     <Grid Grid.Row="1" Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="18,13"><StackPanel><TextBlock Text="В ПОСЛЕДНЕМ ОБНОВЛЕНИИ" FontSize="10" Foreground="#8FAC89" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="12" LineHeight="18" MaxHeight="53"/></StackPanel></Border>
      <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="18,13"><StackPanel><TextBlock Text="Всё своё останется с тобой" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,5"/><TextBlock Text="Настройки, миры и карты сохраняются.&#10;Перед установкой создаётся бэкап." Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="18"/></StackPanel></Border>
     </Grid>
    </Grid>
    <Border x:Name="SettingsView" Visibility="Collapsed" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="28"><StackPanel><TextBlock Text="Настройки и восстановление" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,22"/><TextBlock Text="Папка сборки" FontWeight="SemiBold"/><TextBlock Text="{Binding InstancePath}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="Выбрать другую папку" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding ChooseFolderCommand}"/><TextBlock Text="Резервная копия" FontWeight="SemiBold" Margin="0,28,0,8"/><TextBlock Text="Откат вернёт предыдущие файлы сборки. Личные настройки,&#10;изменённые после обновления, будут сохранены." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><Button Content="Откатить последнее обновление" Style="{StaticResource SecondaryButton}" Command="{Binding RollbackCommand}"/><Button Content="Указать полный архив" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding ImportArchiveCommand}"/></StackPanel><TextBlock Text="Полный архив нужен для первой установки или восстановления редких файлов.&#10;Для обычного обновления он не требуется." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0"/><TextBlock Text="{Binding SourceLabel}" FontFamily="Consolas" FontSize="11" Foreground="#87A27F" TextWrapping="Wrap" Margin="0,28,0,0"/></StackPanel></Border>
   </Grid>
   <Border Grid.Row="2" Background="#162319" CornerRadius="6" Margin="0,17,0,0" Padding="16,11" Visibility="{Binding AppUpdateVisibility}"><DockPanel><Button DockPanel.Dock="Right" Content="Обновить программу" Style="{StaticResource SecondaryButton}" Command="{Binding UpdateAppCommand}" Margin="14,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Доступна новая версия обновлятора" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Он сохранит выбранную сборку и откроется снова." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="3" Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource SecondaryButton}" Command="{Binding CheckCommand}" Margin="12,0,0,0"/><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#8BCA66" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" FontSize="15"/></StackPanel><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="15,6,0,0" TextWrapping="Wrap" MaxWidth="720"/></StackPanel></DockPanel>
    <ProgressBar Grid.Row="1" Height="5" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Background="#2A342C" Foreground="#80C254" BorderThickness="0" Margin="0,0,0,14"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="246"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center"><DockPanel><Button DockPanel.Dock="Right" Content="Изменить" Style="{StaticResource SecondaryButton}" Padding="11,4" MinHeight="30" Command="{Binding ChooseFolderCommand}" Margin="12,0,0,0"/><StackPanel><TextBlock Text="ПАПКА СБОРКИ" FontSize="9" Foreground="#8CA18A" FontWeight="SemiBold"/><TextBlock Text="{Binding InstancePath}" Foreground="#C1CFC2" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/></StackPanel></DockPanel><CheckBox Content="Перенести конфликтующие моды в бэкап" Foreground="#E3CEA3" Visibility="{Binding ConflictVisibility}" IsChecked="{Binding QuarantineConflicts}" Margin="0,8,0,0"/></StackPanel>
     <Button Grid.Column="2" Content="{Binding MainButtonLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" ToolTip="Загрузить только изменённые файлы и обновить сборку"/>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
