<Application x:Class="Mosslight.Update.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#111514"/><SolidColorBrush x:Key="PanelBrush" Color="#1C221E"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A8B5AC"/><SolidColorBrush x:Key="GreenBrush" Color="#8DD16A"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF2ED"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="FocusStyle" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="#B2F18C" BorderThickness="2" CornerRadius="5" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
   <Setter Property="Foreground" Value="#D9E4DC"/><Setter Property="Background" Value="#29322C"/><Setter Property="BorderBrush" Value="#3B473F"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource FocusStyle}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#354337"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#203624"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
   <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="20"/><Setter Property="MinHeight" Value="58"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border Background="#24551B" CornerRadius="5" Margin="0,4,0,0"/><Border x:Name="Face" CornerRadius="5" Margin="0,0,0,4"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#60B23F" Offset="0"/><GradientStop Color="#3C8727" Offset="1"/></LinearGradientBrush></Border.Background><ContentPresenter Margin="22,13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#67B94A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Margin" Value="0,3,0,1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
